#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
python3 tools/check_public_files.py --staged
email=$(git var GIT_AUTHOR_IDENT)
case "$email" in
  *'@users.noreply.github.com>'*|*'<noreply@github.com>'*) ;;
  *) echo 'Commit blocked: configure a GitHub noreply author email.' >&2; exit 1 ;;
esac
email=$(git var GIT_COMMITTER_IDENT)
case "$email" in
  *'@users.noreply.github.com>'*|*'<noreply@github.com>'*) ;;
  *) echo 'Commit blocked: configure a GitHub noreply committer email.' >&2; exit 1 ;;
esac
