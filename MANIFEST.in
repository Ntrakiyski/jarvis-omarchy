include README.md CONTRIBUTING.md SECURITY.md LICENSE
include install.sh uninstall.sh
recursive-include bin *
recursive-include share *
recursive-include omarchy *
recursive-include plugin *.qml *.json
recursive-include docs *.md
recursive-include tests *.py
recursive-include tools *.py
prune docs/private
prune benchmarks
prune .git
prune .venv
global-exclude __pycache__ *.py[cod] *.log *.jsonl *.sqlite* *.db .env .env.* *.pem *.key
