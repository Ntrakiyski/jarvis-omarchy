#!/usr/bin/env python3
"""jarvis-voice launcher.

Prefers the private environment installed next to it (``<prefix>/.venv``), so the
daemon and the CLI do not depend on whichever ``python3`` happens to be first on
PATH — a system service and an interactive shell resolve PATH differently, and a
mise/uv python bump would otherwise break voice silently.
"""
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
venv = ROOT / ".venv"
venv_python = venv / "bin" / "python"
# Test by prefix, not by resolving the interpreter: a venv's bin/python is a
# symlink to the very interpreter that created it, so resolved paths compare
# equal and the switch would be skipped — leaving the daemon on a python that
# may not have websockets.
if venv_python.exists() and Path(sys.prefix) != venv:
    os.execv(str(venv_python), [str(venv_python), str(Path(__file__).resolve()), *sys.argv[1:]])

sys.path.insert(0, str(ROOT / "src"))

from omarchy_voice.cli import main

if __name__ == "__main__":
    sys.exit(main())
