-- jarvis-voice — add to ~/.config/hypr/bindings.lua
--
-- One key, one meaning: SUPER + SHIFT + V starts listening, pauses the
-- microphone, and resumes — always in the same session, and it opens the Jarvis
-- window the first time. There is no hold-to-talk and no always-on mode. While
-- listening, room audio streams to the API and the window/bar say so; paused or
-- off, no recorder is running at all.
--
-- Deliberately avoids SUPER + V and SUPER + CTRL + V: Omarchy binds those to
-- Universal paste and the clipboard manager. Check your current bindings before
-- using SUPER + SHIFT + V; local customizations may already use it.

if o.cmd_present("jarvis-voice-app") then
  o.bind("SUPER + SHIFT + V", "Jarvis: listen / pause", "jarvis-voice-app toggle")
  -- While the bar shows "waiting for confirmation", click the widget or:
  -- o.bind("SUPER + SHIFT + Y", "Confirm voice action", "jarvis-voice listen confirm")
end
